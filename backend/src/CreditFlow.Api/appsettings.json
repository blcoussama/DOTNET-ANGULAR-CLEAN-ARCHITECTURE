{
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": false,
    "StartupConnectRetries": 10
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "CreditFlow",
    "Audience": "CreditFlow",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  },
  "Scoring": {
    "MaxDebtRatio": 0.40
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Seed": {
    "DemoData": true,
    "AdminEmail": "admin@creditflow.local",
    "AnalystEmail": "analyste@creditflow.local",
    "ClientEmail": "client@creditflow.local"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
