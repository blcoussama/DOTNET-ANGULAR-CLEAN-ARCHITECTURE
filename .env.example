# Variables lues par docker-compose.yml.
#   cp .env.example .env   puis compléter les valeurs vides.
# Ne jamais committer .env (il est ignoré par .gitignore). Aucune valeur réelle ne doit figurer ici.
#
# Dans .env, éviter les caractères  $  ;  '  "  dans les mots de passe : « $ » est interprété par
# Compose et « ; » casserait la chaîne de connexion SQL Server.

# --- Environnement ASP.NET Core ---
# Production (par défaut) ou Development. En Development, l'API expose OpenAPI/Scalar et crée
# les comptes et données de démonstration (mots de passe : voir plus bas).
ASPNETCORE_ENVIRONMENT=Production

# --- SQL Server (OBLIGATOIRE) ---
# Mot de passe du compte « sa » : 8 caractères minimum et 3 catégories parmi majuscules,
# minuscules, chiffres, symboles (sinon SQL Server refuse de démarrer).
# Exemple de génération : echo "Cf1-$(openssl rand -hex 16)"
MSSQL_SA_PASSWORD=
# Nom de la base créée par les migrations EF Core au démarrage de l'API.
MSSQL_DATABASE=CreditFlow
# Édition SQL Server : Developer (gratuite, hors production) ou Express.
MSSQL_PID=Developer
# Port publié sur 127.0.0.1 uniquement (outils SQL, « dotnet run » hors conteneur).
MSSQL_HOST_PORT=1433

# --- JWT (OBLIGATOIRE pour l'API) ---
# Clé de signature HMAC : au moins 32 octets aléatoires (256 bits), sinon l'API refuse de démarrer.
# Exemple : openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Comptes de démonstration (uniquement si ASPNETCORE_ENVIRONMENT=Development) ---
# admin@creditflow.local, analyste@creditflow.local, client@creditflow.local.
# Un compte dont le mot de passe est vide n'est pas créé. Politique Identity : voir README.
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
SEED_CLIENT_PASSWORD=

# --- Frontend / CORS ---
# Origine publique de la SPA (le navigateur appelle l'API via nginx, sur la même origine).
CORS_ALLOWED_ORIGIN=http://localhost:8080
# Adresse et port d'écoute sur l'hôte (127.0.0.1 = accessible uniquement depuis cette machine).
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

# --- Images ---
# Étiquette des images construites localement (creditflow-api:<tag>, creditflow-frontend:<tag>).
IMAGE_TAG=local
